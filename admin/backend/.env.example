# Copy this to .env and fill in real values before running.

# PostgreSQL — points at the admin_db service in docker-compose.yml by
# default. To share your existing PillPoints Postgres instance instead,
# point this at that host/port/db (e.g.
# postgresql://user:pass@187.127.150.252:5435/ace_admin_db) — just make
# sure the database itself exists first (CREATE DATABASE ace_admin_db;).
DATABASE_URL=postgresql://ace_admin:changeme@admin_db:5432/ace_admin_db

# JWT signing secret — generate a real one before deploying:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_BEFORE_DEPLOYING
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# Seeded on first startup if no admin user exists yet. Change the password
# immediately after first login — there's no "forgot password" flow in
# this MVP, so if you lose it, reset it directly in the database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Comma-separated list of origins allowed to call this API — add your
# admin frontend's URL and the main site's URL here.
# With the same-domain reverse-proxy setup (see admin/README.md), the
# admin frontend and main site both call this API from the SAME origin
# as the API itself, so CORS isn't actually exercised in production —
# this only matters if you run the admin frontend locally against this
# deployed backend, or deploy them on genuinely separate domains.
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,https://ace-preview.duckdns.org

# AI-powered CV matching — leave both blank to disable this feature
# entirely (résumé upload and the free keyword search still work fine
# without them). See admin/README.md "AI-powered CV matching" for full
# setup instructions.
#
# Reuse the SAME key already used for PillPoints' visual search feature —
# no new Anthropic account/billing needed. Find the real value in
# PillPoints' backend .env on this same VPS and copy it here.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Voyage AI is a SEPARATE service from Anthropic — this needs its own
# account and its own API key, which can't be reused from PillPoints.
# Sign up free at https://www.voyageai.com (first 200M tokens are free).
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite
